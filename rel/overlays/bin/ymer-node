#!/bin/sh
# ymer-node — the operator's verbs for the node running on this machine.
#
# Every verb is one `rpc` into the node that is ALREADY SERVING. It does not
# boot a second VM: two VMs on one SQLite file is exactly what this shape
# avoids, and it is also why `ymer-node scripts list` answers instantly.
#
# The file is named with a HYPHEN on purpose. Mix copies release overlays over
# the built release last, so an overlay named `ymer_node` would silently
# replace the release's own launcher — the one this script calls.
#
# Arguments are packed rather than interpolated: `rpc` takes an Elixir
# expression as a string, so an argument containing a quote or a `#{}` would
# otherwise close it and be evaluated. NUL-joined and base64'd, nothing an
# operator types is syntax by the time it reaches the node.
set -eu

here=$(cd -- "$(dirname -- "$0")" && pwd)

if [ "$#" -eq 0 ]; then
  set -- help
fi

packed=$(printf '%s\0' "$@" | base64 | tr -d '\n')

exec "$here/ymer_node" rpc "YmerNode.Scripts.CLI.main(\"$packed\")"
